# 독립 개발용 API 포트
BUSINESS_CARD_STANDALONE_PORT=3101

# 독립 프로젝트는 로컬 JSON 저장소를 사용합니다.
DB_PROVIDER=local

# GitHub 협업 중에는 실제 메일 발송을 끈 상태로 사용하세요.
BUSINESS_CARD_MAIL_ENABLED=false

# 아래 값은 실제 SMTP 연동을 검토할 때만 로컬 .env에 작성합니다.
# 비밀번호가 포함된 .env는 GitHub에 올리지 마세요.
BUSINESS_CARD_SMTP_HOST=
BUSINESS_CARD_SMTP_PORT=587
BUSINESS_CARD_SMTP_SECURE=false
BUSINESS_CARD_SMTP_USER=
BUSINESS_CARD_SMTP_PASSWORD=
BUSINESS_CARD_MAIL_FROM=
